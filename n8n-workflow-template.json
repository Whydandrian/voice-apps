{
  "name": "Voice Call AI Workflow",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-call",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - Streaming Audio",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "voice-call"
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "voice-call/final",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook - Final Recording",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 600],
      "webhookId": "voice-call-final"
    },
    {
      "parameters": {
        "url": "https://api.elevenlabs.io/v1/convai/conversation",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "elevenLabsApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "audio",
              "value": "={{ $binary.audio }}"
            }
          ]
        },
        "options": {}
      },
      "name": "ElevenLabs - Process Audio",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "upload",
        "folderId": {
          "__rl": true,
          "value": "YOUR_GOOGLE_DRIVE_FOLDER_ID",
          "mode": "list",
          "cachedResultName": "Voice Recordings"
        },
        "name": "={{ $json.body.audio[0].filename }}",
        "options": {}
      },
      "name": "Google Drive - Save Recording",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [450, 600]
    },
    {
      "parameters": {
        "url": "https://api.elevenlabs.io/v1/speech-to-text",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "elevenLabsApi",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "name": "audio",
              "value": "={{ $binary.audio }}"
            },
            {
              "name": "language",
              "value": "id"
            }
          ]
        },
        "options": {}
      },
      "name": "ElevenLabs - Speech to Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [650, 600]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"transcription\": $json.text, \"fileId\": $('Google Drive - Save Recording').item.json.id } }}",
        "options": {}
      },
      "name": "Respond with Transcript",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [850, 600]
    }
  ],
  "connections": {
    "Webhook - Streaming Audio": {
      "main": [
        [
          {
            "node": "ElevenLabs - Process Audio",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ElevenLabs - Process Audio": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook - Final Recording": {
      "main": [
        [
          {
            "node": "Google Drive - Save Recording",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Google Drive - Save Recording": {
      "main": [
        [
          {
            "node": "ElevenLabs - Speech to Text",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ElevenLabs - Speech to Text": {
      "main": [
        [
          {
            "node": "Respond with Transcript",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "pinData": {}
}
